# AI Writing Coach — local development environment
# Copy to .env (same directory). Never commit the real .env.
# Local-only defaults; not production credentials.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=ai_writing_coach
POSTGRES_USER=awc
POSTGRES_PASSWORD=awc_local_dev
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Must match the PostgreSQL values above. Driver: SQLAlchemy 2.x + psycopg 3.
# Use 127.0.0.1 (not localhost): the db port is bound to IPv4 loopback only,
# and localhost may resolve to a blackholed ::1 first on this machine.
DATABASE_URL=postgresql+psycopg://awc:awc_local_dev@127.0.0.1:5432/ai_writing_coach
# Seconds before a database connection attempt is aborted (health probe).
DATABASE_CONNECT_TIMEOUT=5
# JSON array; local frontend origin only.
# Frontend uses port 3500: port 3000 is inside a Windows Hyper-V/WinNAT
# excluded port range on the dev machine (EACCES on bind).
CORS_ORIGINS=["http://localhost:3500"]

# --- Authentication (Stage 2 Slice 1) ---
# REQUIRED in any real deployment: set a long random secret (>= 64 chars).
# The built-in default is dev-only and insecure.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-characters-long!!
JWT_ISSUER=ai-writing-coach
JWT_AUDIENCE=ai-writing-coach-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=awc_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
# In-process rate limit reservation for register/login (per client IP).
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Frontend (Next.js) ---
# Next.js reads env files from frontend/, so also copy this line into
# frontend/.env.local (see frontend/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Grammar checking (Stage 2 Slice 3) ---
# Self-hosted LanguageTool (docker compose service 'languagetool').
LANGUAGE_TOOL_URL=http://127.0.0.1:8010
LANGUAGE_TOOL_TIMEOUT_SECONDS=15
LANGUAGE_TOOL_LANGUAGE=en-US

# --- LLM provider (Stage 2 Slice 3) ---
# mock: deterministic dev/test provider, zero cost, NOT for production.
# openai_compat: any OpenAI-compatible chat completions endpoint.
# Real keys are required before AI linguistic quality can be verified.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Optional pricing for cost estimates (USD per 1K tokens).
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
